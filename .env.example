# App / Clerk authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# One Turso/libSQL database for both automations and Link Studio.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Prisma generates migration SQL against a local SQLite file before the
# db:migrate:turso script applies it remotely.
LOCAL_DATABASE_URL=file:./data/kult-prisma.db

# Optional: refresh the 30-day performance snapshot every 12 hours.
PERFORMANCE_SYNC_INTERVAL_MS=43200000
# Optional: worker reconciliation sweep every five minutes.
COMMENT_POLL_INTERVAL_MS=300000

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
# App settings > Basic. The app ID and client token are retained for operator
# reference; the current OAuth implementation does not send the client token.
FACEBOOK_APP_ID=your-meta-app-id
META_CLIENT_TOKEN=your-meta-client-token
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional Backblaze B2 media bucket for scheduler image/video uploads.
# Configure on web + worker. Private buckets use fresh signed download URLs.
# Direct URL scheduling works without it.
# Bucket/prefix-scoped key: listBuckets/listFiles/readFiles/writeFiles/deleteFiles.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# Set the bucket name for ownership validation and missing-credential diagnostics.
B2_BUCKET_NAME=

# ChatGPT MCP: dedicated Clerk OAuth application (authorization code + S256 PKCE).
# Prefer JWT access tokens with Clerk aud_claim_enabled=true and S256 PKCE.
# "custom" enforces kult:read/kult:write scopes (when supported by the instance).
# "clerk" uses profile/email for account linking and a server-owned access grant.
# Clerk compatibility mode requires a resource-audience JWT; writes default OFF.
# Client secret belongs in ChatGPT's OAuth configuration, not in this app.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev
MCP_OAUTH_SCOPE_MODE=custom
MCP_OAUTH_WRITE_ENABLED=false
